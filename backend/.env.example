# Use um banco de desenvolvimento, nunca produção para testes.
MONGODB_URI=
PORT=5000
NODE_ENV=development
# Gere um segredo aleatório local; mínimo de 32 caracteres.
JWT_SECRET=
JWT_EXPIRE=1h
# Provisionamento manual do primeiro administrador, somente quando necessário.
# Remova as variáveis ADMIN_* após usar npm run create-admin.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
