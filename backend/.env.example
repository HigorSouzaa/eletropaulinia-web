# Use um banco de desenvolvimento, nunca produção para testes.
MONGODB_URI=
PORT=5000
# Escuta local por padrão. Em hospedagem com proxy externo, configure explicitamente se necessário.
API_HOST=127.0.0.1
NODE_ENV=development
# Gere um segredo aleatório local; mínimo de 32 caracteres.
JWT_SECRET=
JWT_EXPIRE=1h
# Origens web exatas separadas por vírgula, por exemplo o domínio do Next em produção.
CORS_ORIGINS=
# Provisionamento manual do primeiro administrador, somente quando necessário.
# Remova as variáveis ADMIN_* após usar npm run create-admin.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_PASSWORD=
