{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start-all": "concurrently \"npm --prefix backend run dev\" \"npm run dev\"",
    "setup": "npm ci --ignore-scripts --no-audit && npm --prefix backend ci --ignore-scripts --no-audit",
    "new": "npm run setup && npm run start-all",
    "test": "npm --prefix backend test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "engines": { "node": ">=24 <25" },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "axios": "^1.6.2",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
