{
  "name": "eletropaulinia-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start-all": "concurrently \"npm --prefix backend run dev\" \"npm run dev\"",
    "setup": "npm ci --ignore-scripts --no-audit && npm --prefix backend ci --ignore-scripts --no-audit",
    "new": "npm run setup && npm run start-all",
    "test": "npm --prefix backend test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "preview": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "9.2.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  }
}
